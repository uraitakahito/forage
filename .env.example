# forage の設定。**このファイルが .env の唯一の出どころ** —— setup.sh はこれを写すだけ。
#
# 書いてよい行は 2 つの形だけ:
#   NAME=value    値がある
#   #NAME=value   既定値がある。変えたいときだけコメントを外す
#
# 生の `NAME=` (空文字) は書かないこと。空文字は「無い」より悪い ——
# 既定値を潰したうえで、名前が一言も出ないエラーになる。

# ── Windmill ────────────────────────────────────────────────────────────

# Windmill の URL。host 側の道具 (この repo の scripts/) が使う。
#WINDMILL_URL=http://127.0.0.1:8000

# workspace の id。scripts/bootstrap.mjs が無ければ作る。
#WINDMILL_WORKSPACE=crawler

# bootstrap が作った API token。**`pnpm run windmill:bootstrap` の出力を貼る。**
# 起動前には決まらないので、setup.sh は空のまま残す。
WINDMILL_TOKEN=

# Windmill の初回ログイン。上流の既定のまま。
#WINDMILL_EMAIL=admin@windmill.dev
#WINDMILL_PASSWORD=changeme

# ── waggle ──────────────────────────────────────────────────────────────

# **コンテナから見た** waggle-api の URL。host は既定のブリッジ gateway。
# waggle 側で WAGGLE_API_HOST=0.0.0.0 にしていないと、ここには届かない。
#WAGGLE_API_URL=http://192.168.64.1:7070

# host から見た waggle の dev OIDC issuer。**loopback のままにすること** ——
# この issuer は頼まれれば誰の名前でもトークンを出すので、外に出した瞬間に
# 「ブリッジに届く誰もが windmill を名乗れる」になる。
# 鍵を作るのは host、コンテナへ渡すのは出来上がったトークンだけ。
#WAGGLE_OIDC_ISSUER=http://127.0.0.1:9099

# トークンに載せる主体と組織。この主体に submitter の付与が要る:
#   cd ../waggle && pnpm run fga:grant submitter windmill acme
#WAGGLE_SUBJECT=windmill
#WAGGLE_ORGANIZATIONS=acme

# トークンの寿命 (jose の綴り)。issuer を再起動すると鍵ごと変わるので、
# どれだけ長くしても再起動には勝てない。
#WAGGLE_TOKEN_EXPIRES_IN=30d
